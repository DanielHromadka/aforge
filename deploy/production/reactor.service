[Unit]
Description=Reactor application
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=reactor
Group=reactor
WorkingDirectory=/opt/reactor/current
EnvironmentFile=/etc/reactor/production.env
ExecStart=/usr/bin/node --import tsx apps/server/src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/reactor /run/reactor
RuntimeDirectory=reactor
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=65536
MemoryMax=3G
TasksMax=512

[Install]
WantedBy=multi-user.target
